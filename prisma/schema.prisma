generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  emailVerified  DateTime? // required by NextAuth PrismaAdapter
  name           String?
  image          String?
  timezone       String     @default("Europe/Zurich")
  onboardingDone Boolean    @default(false)
  plan           String     @default("free")
  creditsBalance Int        @default(5000) // trial credits
  trialEndsAt    DateTime?
  preferences    Json? // scheduling prefs, theme, channels
  accounts       Account[]
  sessions       Session[]
  assistant      Assistant?
  threads        Thread[]
  routines       Routine[]
  wikiPages      WikiPage[]
  people         Person[]
  notes          Note[]
  docs           Doc[]
  logs           AppLog[]
}

model AppLog {
  id        String   @id @default(cuid())
  userId    String
  source    String // routine | chat | inbound | system
  message   String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "google" | "azure-ad"
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at              Int?
  refresh_token_expires_in Int?
  token_type              String?
  scope                   String?
  id_token                String? @db.Text
  session_state           String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assistant {
  id          String  @id @default(cuid())
  userId      String  @unique
  name        String  @default("Assistant")
  slug        String  @unique // name@ourdomain.com
  personality String  @default("Minimal, high-signal, and brief.")
  avatar      String  @default("neutral") // our own icon set, not Town's art
  voiceName   String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Thread {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New thread")
  createdAt DateTime  @default(now())
  messages  Message[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id       String @id @default(cuid())
  threadId String
  role     String // user | assistant | tool
  content  String @db.Text
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Routine {
  id        String    @id @default(cuid())
  userId    String
  key       String // auto-inbox | morning-briefing | meeting-briefing | loose-ends
  enabled   Boolean   @default(false)
  config    Json?
  lastRunAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Integration {
  id        String  @id @default(cuid())
  userId    String
  provider  String // google | microsoft | slack | notion | github ...
  scopes    String?
  connected Boolean @default(true)

  @@unique([userId, provider])
}

model WikiPage {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Person {
  id     String  @id @default(cuid())
  userId String
  name   String
  email  String?
  notes  String  @db.Text
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id      String @id @default(cuid())
  userId  String
  content String @db.Text
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Doc {
  id        String   @id @default(cuid())
  userId    String
  title     String
  kind      String   @default("document")
  content   String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
